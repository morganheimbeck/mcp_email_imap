# Required — IMAP settings (also used for SMTP by default)
EMAIL_HOST=imap.mail.us-east-1.awsapps.com
EMAIL_PORT=993
EMAIL_USER=user@example.com
EMAIL_PASS=password

# Optional — override SMTP settings if different from above
# SMTP_HOST=smtp.mail.us-east-1.awsapps.com
# SMTP_PORT=465
# SMTP_USER=user@example.com
# SMTP_PASS=password
